# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (dev + prod dashboard/website)
FRONTEND_URL=http://localhost:5173

# ---- Reverse proxy / client IPs ----
# Leave empty when the API is directly reachable — rate limits then use the socket IP,
# which a client cannot spoof. Set TRUST_PROXY=1 only when exactly one proxy you
# control (nginx, Cloudflare, a PaaS router) sits in front. Setting this wrongly lets
# callers forge X-Forwarded-For and bypass the login throttles.
TRUST_PROXY=

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/dental_demo

# ---- Auth (JWT + cookie) ----
# Required in production, minimum 32 characters. Startup refuses the dev default
# or anything shorter when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Set true in production (HTTPS) so the auth cookie is only sent over TLS.
# Production forces this on regardless of the value here.
COOKIE_SECURE=false

# ---- Admin bootstrap (used ONLY by `npm run seed`, never committed with real values) ----
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@demodentalcare.com
ADMIN_PASSWORD=ChangeMe123!
# Demo-only: skip the 12-character minimum for ADMIN_PASSWORD when seeding in
# production. Leave false (or unset) for any real deployment.
ALLOW_WEAK_ADMIN_PASSWORD=false

# ---- Email notifications ----
# console = log only (safe default for demo/dev) | smtp = Brevo/SendGrid via SMTP | resend = Resend HTTP API
EMAIL_PROVIDER=console
# Verified sender shown to recipients (must be verified with your provider for smtp/resend)
EMAIL_FROM="Demo Dental Care <no-reply@demodentalcare.com>"
# Staff inbox that receives new-request notifications
CLINIC_NOTIFY_EMAIL=clinic@demodentalcare.com
# Send a short acknowledgement to the patient when they supplied an email address
PATIENT_ACK_ENABLED=false

# SMTP settings (only needed when EMAIL_PROVIDER=smtp; works with Brevo / SendGrid SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend settings (only needed when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ---- Public site links (used as fallbacks until Clinic content is seeded in DB) ----
CLINIC_WHATSAPP_NUMBER=15551234567
CLINIC_ADDRESS=123 Smile Street, Demo City
